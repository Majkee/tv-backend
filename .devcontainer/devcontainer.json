{
  "name": "Lumio TV backend",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": { "label": "Telewizor", "onAutoForward": "notify" }
  },
  "postCreateCommand": "chmod +x run_tests.sh run_server.sh && ./run_tests.sh",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "saoudrizwan.claude-dev"]
    }
  }
}
